# Copy to .env and fill in. Keep .env private.

# Required: a long random string (run: python3 -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me

# Set to 1 when the site is served over HTTPS (recommended), so login cookies are HTTPS-only.
COOKIE_SECURE=0

TIMEZONE=Asia/Riyadh

# Email (needed for the daily report and branch reminders). Leave SMTP_HOST empty to turn email off.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=1
SMTP_SSL=0
MAIL_FROM=AHS Sources <reports@your-company.com>
